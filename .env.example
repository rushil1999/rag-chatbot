# Copy to app/.env and fill in. Never commit the real file.

# MongoDB Atlas connection string (database: personal_assisstant_chat).
# Requires an Atlas Vector Search index named "vector_search" on the
# data_embeddings collection, indexing the "text_embeddings" field.
MONGODB_URI=

# Cohere API key, used for embed-v4.0 embeddings.
COHERE_EMBEDDING_API_KEY=

# xAI API key for Grok.
GROK_API_KEY=

# Browser-visible token. It ships inside the portfolio bundle and is therefore NOT a secret —
# it only reaches /chat/response, /chat/stream and /test, and those are rate limited.
PUBLIC_TOKEN=

# Server-side only. Required for vector writes, embedding generation and reading transcripts.
# Never put this in the frontend.
ADMIN_TOKEN=

# Comma-separated browser origins allowed to call the API.
ALLOWED_ORIGINS=https://rushil1999.github.io,http://localhost:3000

# Minimum cosine similarity for a retrieved chunk to count as a strong match (default 0.75).
COSINE_SIMILARITY_THRESHOLD=0.75

# Per-client rate limit on chat endpoints.
RATE_LIMIT_MAX_REQUESTS=20
RATE_LIMIT_WINDOW_SECONDS=600

# Leave unset in production — enabling it exposes tracebacks to clients.
DEBUG=
